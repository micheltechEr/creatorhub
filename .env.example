# =============================================================================
# CreatorHub — Variáveis de Ambiente
# Copie para .env e preencha os valores
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usado pelo docker-compose (desenvolvimento local)
POSTGRES_USER=artistflow
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=artistflow

# Connection string (Render usa DATABASE_URL internamente via PostgreSQL service)
# Para docker-compose local: aponta para o serviço "db"
DATABASE_URL=postgresql://artistflow:change_me_in_production@db:5432/artistflow

# ── Autenticação (JWT) ───────────────────────────────────────────────────────
# Gere secrets seguros com: openssl rand -hex 64
JWT_SECRET=change_me_in_production
REFRESH_SECRET=change_me_in_production

# ── Clerk (autenticação do frontend) ─────────────────────────────────────────
# Dashboard: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ── Asaas (gateway de pagamentos) ────────────────────────────────────────────
# Dashboard: https://www.asaas.com/developer
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_ENV=sandbox   # ou: production

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL do frontend permitida para chamadas à API
CORS_ORIGIN=https://your-frontend.onrender.com

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL base da API para o frontend fazer chamadas
VITE_API_BASE_URL=https://your-api.onrender.com