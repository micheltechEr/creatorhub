# Copy this file to .env and fill in the values

# PostgreSQL (used by docker-compose)
POSTGRES_USER=artistflow
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=artistflow

# Connection string for the API server (matches docker-compose db service)
DATABASE_URL=postgresql://artistflow:change_me_in_production@db:5432/artistflow

# JWT secrets — generate with: openssl rand -hex 64
JWT_SECRET=change_me_in_production
REFRESH_SECRET=change_me_in_production

# Asaas payment gateway
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_ENV=sandbox   # or: production
